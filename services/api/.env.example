# Services/api. Template env — SALIN ke `.env` LOKAL, jangan commit `.env`.
# `.env` wajib masuk .gitignore (sudah diatur di root).

# PostgreSQL connection (PostgreSQL & Prisma — lihat README api).
DATABASE_URL="postgresql://mobiljuragan:mobiljuragan@localhost:5432/mobiljuragan?schema=public"

# API
PORT=4000
APP_VERSION=dev
LOG_LEVEL=info

# Secret ini SEMUANYA placeholder. Ganti nilai nyata di env lokal development.
# Jangan commit nilai secret nyata ke repo.
SESSION_SECRET="CHANGE_ME_random_long_string"
